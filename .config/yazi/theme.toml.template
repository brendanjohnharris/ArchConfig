# yazi theme: fathom (Fathom palette).
# Auto-rendered from theme.toml.template by ~/.xmonad/bin/gen-fathom-colors.sh.
# Do not edit theme.toml directly; edit this template and recompile xmonad (M-C-r).
# Schema: https://yazi-rs.github.io/docs/configuration/theme  (uses [mgr], [cmp], [pick])

[mgr]
cwd = { fg = "{{baikal}}" }

# Hovered file/dir -> inverse onto the white accent
hovered         = { fg = "{{chernoe}}", bg = "{{playa}}" }
preview_hovered = { underline = true }

# Find (search-in-directory)
find_keyword  = { fg = "{{seohae}}", italic = true }
find_position = { fg = "{{ianthina}}", bg = "reset", italic = true }

# Yank / selection markers (the thin gutter bar)
marker_copied   = { fg = "{{qinghai}}", bg = "{{qinghai}}" }
marker_cut      = { fg = "{{bermejo}}", bg = "{{bermejo}}" }
marker_marked   = { fg = "{{baikal}}",  bg = "{{baikal}}" }
marker_selected = { fg = "{{seohae}}",  bg = "{{seohae}}" }

# Tabs
tab_active   = { fg = "{{chernoe}}",     bg = "{{playa}}" }
tab_inactive = { fg = "{{abyad_light}}", bg = "{{chernoe_light}}" }
tab_width    = 1

# Operation counters
count_copied   = { fg = "{{chernoe}}", bg = "{{qinghai}}" }
count_cut      = { fg = "{{chernoe}}", bg = "{{bermejo}}" }
count_selected = { fg = "{{chernoe}}", bg = "{{seohae}}" }

# Borders
border_symbol = "│"
border_style  = { fg = "{{chernoe_lighter}}" }

[mode]
normal_main = { fg = "{{chernoe}}", bg = "{{baikal}}",    bold = true }
normal_alt  = { fg = "{{baikal}}",  bg = "{{chernoe_light}}" }
select_main = { fg = "{{chernoe}}", bg = "{{qinghai}}",   bold = true }
select_alt  = { fg = "{{qinghai}}", bg = "{{chernoe_light}}" }
unset_main  = { fg = "{{chernoe}}", bg = "{{ianthina}}",  bold = true }
unset_alt   = { fg = "{{ianthina}}", bg = "{{chernoe_light}}" }

[status]
sep_left  = { open = "", close = "" }
sep_right = { open = "", close = "" }

progress_label  = { fg = "{{playa}}", bold = true }
progress_normal = { fg = "{{baikal}}",  bg = "{{chernoe_light}}" }
progress_error  = { fg = "{{bermejo}}", bg = "{{chernoe_light}}" }

perm_type  = { fg = "{{baikal}}" }
perm_read  = { fg = "{{seohae}}" }
perm_write = { fg = "{{bermejo}}" }
perm_exec  = { fg = "{{qinghai}}" }
perm_sep   = { fg = "{{abyad_dark}}" }

[input]
border   = { fg = "{{baikal}}" }
title    = {}
value    = {}
selected = { reversed = true }

[pick]
border   = { fg = "{{baikal}}" }
active   = { fg = "{{ianthina}}", bold = true }
inactive = {}

[confirm]
border  = { fg = "{{baikal}}" }
title   = { fg = "{{baikal}}" }
content = {}
list    = {}
btn_yes = { fg = "{{chernoe}}", bg = "{{playa}}", bold = true }
btn_no  = {}

[cmp]
border = { fg = "{{baikal}}" }

[tasks]
border  = { fg = "{{baikal}}" }
title   = {}
hovered = { fg = "{{ianthina}}", underline = true }

[which]
mask            = { bg = "{{chernoe_dark}}" }
cand            = { fg = "{{mesopelagic_light}}" }
rest            = { fg = "{{abyad_dark}}" }
desc            = { fg = "{{ianthina}}" }
separator       = "  "
separator_style = { fg = "{{chernoe_lighter}}" }

[help]
on      = { fg = "{{ianthina}}" }
run     = { fg = "{{mesopelagic_light}}" }
desc    = { fg = "{{abyad_light}}" }
hovered = { bg = "{{chernoe_light}}", bold = true }
footer  = { fg = "{{chernoe}}", bg = "{{abyad_light}}" }

[notify]
title_info  = { fg = "{{qinghai}}" }
title_warn  = { fg = "{{seohae}}" }
title_error = { fg = "{{bermejo}}" }

[filetype]
rules = [
  { mime = "image/*", fg = "{{seohae}}" },
  { mime = "video/*", fg = "{{ianthina}}" },
  { mime = "audio/*", fg = "{{ianthina}}" },
  { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{bermejo}}" },
  { mime = "application/{pdf,doc,rtf}", fg = "{{qinghai}}" },
  { url = "*", is = "orphan", fg = "{{bermejo}}" },
  { url = "*", is = "exec",   fg = "{{qinghai}}" },
  { url = "*/", fg = "{{baikal}}" },
]
