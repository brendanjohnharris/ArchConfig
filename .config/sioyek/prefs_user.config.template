# sioyek — PDF reader for papers. https://sioyek.info/
# Auto-rendered from prefs_user.config.template by ~/.xmonad/bin/gen-fathom-colors.sh.
# Do not edit prefs_user.config directly; edit this template and recompile xmonad (M-C-r).
# sioyek colours are space-separated 0-1 RGB floats, produced by the :rgbf suffix.

# --- The "desk" (area behind/around the pages) ------------------------------
# Near-black fathom surround so white pages float and pop. The status bar and UI
# sit one shade lighter (chernoe) so the chrome reads as distinct from the desk.
background_color           {{chernoe_dark:rgbf}}
page_separator_width       3
page_separator_color       {{chernoe_lighter:rgbf}}

# --- On-page colours (selection / search / links / ruler) -------------------
text_highlight_color       {{playa:rgbf}}        # text selection -> the white accent
search_highlight_color     {{seohae:rgbf}}       # search hits -> orange
link_highlight_color       {{baikal:rgbf}}       # hyperlinks -> blue
synctex_highlight_color    {{ianthina:rgbf}}     # SyncTeX jump -> purple
visual_mark_color          {{baikal:rgbf}} 0.18  # ruler / visual line (subtle blue wash)

# --- Custom colour mode (toggle): warm-dark fathom reading mode -------------
custom_background_color    {{chernoe:rgbf}}
custom_text_color          {{abyad_light:rgbf}}

# --- Built-in dark mode (toggle): fathom-tinted instead of pure black --------
dark_mode_background_color {{chernoe:rgbf}}
dark_mode_contrast         0.85

# --- UI chrome (command palette, search bar, menus, status bar) -------------
ui_font                    Source Sans 3
font_size                  16
ui_text_color              {{abyad_light:rgbf}}
ui_background_color        {{chernoe:rgbf}}
ui_selected_text_color     {{chernoe:rgbf}}
ui_selected_background_color {{playa:rgbf}}
status_bar_color           {{chernoe:rgbf}}
status_bar_text_color      {{abyad_light:rgbf}}
status_bar_font_size       14

# Show the fathom background (not white) for pages that haven't rendered yet,
# so scrolling never flashes white on the dark desk.
should_draw_unrendered_pages 0

# --- Highlight type colours (keys a-e map to the highlight palette) ---------
highlight_color_a          {{seohae:rgbf}}    # a -> orange
highlight_color_b          {{qinghai:rgbf}}   # b -> green
highlight_color_c          {{baikal:rgbf}}    # c -> blue
highlight_color_d          {{bermejo:rgbf}}   # d -> red
highlight_color_e          {{ianthina:rgbf}}  # e -> purple

# --- SyncTeX: jump PDF -> source in VSCode (Ctrl-click / 'inverse search') --
# %1 = file path, %2 = line number.
inverse_search_command     code -g %1:%2

# --- Embed highlights into the PDF on demand --------------------------------
# sioyek stores highlights in its own SQLite DB, NOT in the PDF, so they are
# invisible in other readers until "burned in". This manual command rewrites
# the file with the highlights embedded (needs the AUR `python-sioyek` package).
# NOTE: sioyek parses the value as a sequence of its own commands UNLESS the whole
# external command is wrapped in one pair of double quotes -- without that wrapper
# it mis-parses and aborts on startup. Inner paths use single quotes for safety.
new_command _embed_annotations "python -m sioyek.embed_annotations '%{file_path}' '%{file_path}' --sioyek-path /usr/bin/sioyek"
