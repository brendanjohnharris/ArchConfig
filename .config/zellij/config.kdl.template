// zellij — terminal multiplexer. https://zellij.dev/documentation/
// Auto-rendered from config.kdl.template by ~/.xmonad/bin/gen-fathom-colors.sh.
// Do not edit config.kdl directly; edit this template and recompile xmonad (M-C-r).

theme "fathom"

// X11 clipboard so y/copy in zellij lands in the system clipboard (not OSC52).
copy_command "xclip -selection clipboard"
copy_clipboard "system"
copy_on_select true

pane_frames true
// "compact" swaps the full status-bar (which shows the keybinding hints) for the
// minimal compact-bar, which omits them. Use the default layout to keep the hints.
default_layout "default"
mouse_mode true
scroll_buffer_size 50000

// Open panes in fish (zellij otherwise inherits $SHELL, which is bash here).
default_shell "fish"

// Don't persist sessions across reboots by default.
session_serialization false

// The 8+2 colour spec; zellij maps these onto its UI roles automatically.
themes {
    fathom {
        fg     "{{abyad_light}}"
        bg     "{{chernoe}}"
        black  "{{chernoe_dark}}"
        red    "{{bermejo}}"
        green  "{{qinghai}}"
        yellow "{{seohae}}"
        blue   "{{baikal}}"
        magenta "{{ianthina}}"
        cyan   "{{mesopelagic}}"
        white  "{{playa}}"
        orange "{{epipelagic}}"
    }
}
