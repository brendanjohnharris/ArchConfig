/**
 * ROFI theme: fathom (horizontal top bar, ~xmobar height, Fathom palette).
 * Minimal delta from the proven dt-dmenu structure (which renders drun+icons
 * correctly) -- only colours/sizes changed, no element border-radius/background
 * (those broke drun's filtered rendering in rofi v2).
 * Auto-rendered from fathom.rasi.template by ~/.xmonad/bin/gen-fathom-colors.sh.
 * Do not edit fathom.rasi directly; edit this template and recompile xmonad (M-C-r).
 */

* {
    background-color:           {{chernoe}};
    border-color:               {{chernoe}};
    text-color:                 {{abyad_light}};
    height:                     32px;
    font:                       "SauceCodePro Nerd Font Medium 16";
    prompt-font:                "Source Sans 3 Bold 16";
    prompt-background:          {{chernoe_light}};   /* subtle grey box (was bright baikal) */
    prompt-foreground:          {{abyad_light}};     /* light text on the grey box */
    selected-normal-background: {{playa}};           /* selection = the white accent */
    selected-normal-foreground: {{chernoe}};
}
#window {
    anchor:   north;
    location: north;
    width:    100%;
    padding:  0px;
    children: [ horibox ];
}
#horibox {
    orientation: horizontal;
    children:    [ prompt, entry, listview ];
}
#prompt {
    padding:          0px 16px;            /* square box, flush to the left edge */
    background-color: @prompt-background;
    text-color:       @prompt-foreground;
    font:             @prompt-font;
    vertical-align:   0.5;
}
#entry {
    padding:        0px 10px;
    expand:         false;
    width:          12em;
    placeholder:    "search";
    vertical-align: 0.5;
}
#listview {
    layout: horizontal;
    lines:  100;
}
#element {
    padding: 2px 10px;
}
#element selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}
element-icon {
    background-color: transparent;
    margin:          0 8px 0 0;
    vertical-align:  0.5;
}
element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}
