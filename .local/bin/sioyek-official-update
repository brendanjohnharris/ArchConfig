#!/usr/bin/env bash
# Install/refresh the OFFICIAL prebuilt sioyek binary into ~/.local, shadowing the
# AUR `sioyek` package via a ~/.local/bin/sioyek wrapper (which precedes /usr/bin in PATH).
#
# Why: the AUR `sioyek` is compiled with Arch's -D_GLIBCXX_ASSERTIONS hardening, which
# turns upstream's latent empty-vector read (ahrm/sioyek#1401) into a HARD ABORT the
# moment you search. The official release binary isn't built with that flag, so search
# works. Same ~/.config/sioyek + ~/.local/share/sioyek are used, so the fathom theming
# and your highlights are preserved.
#
# No sudo and no fuse2: the AppImage is *extracted*, not mounted. The AUR `sioyek`
# package is kept installed only for its .desktop, icon, and /usr/share/sioyek assets;
# its binary is never invoked because the wrapper wins on PATH.
set -euo pipefail

VERSION="v2.0.0"   # bump when a newer sioyek release ships
URL="https://github.com/ahrm/sioyek/releases/download/${VERSION}/sioyek-release-linux-portable.zip"
OPT="${HOME}/.local/opt/sioyek-official"
WRAP="${HOME}/.local/bin/sioyek"

tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT

echo "==> downloading official sioyek ${VERSION}..."
curl -fSL "$URL" -o "$tmp/s.zip"
( cd "$tmp" && unzip -q s.zip && chmod +x Sioyek-x86_64.AppImage \
    && ./Sioyek-x86_64.AppImage --appimage-extract >/dev/null )

bin="$tmp/squashfs-root/usr/bin/sioyek"
[ -x "$bin" ] || { echo "ERROR: sioyek binary not found in the AppImage" >&2; exit 1; }

echo "==> installing to $OPT"
rm -rf "$OPT"; mkdir -p "$(dirname "$OPT")"
mv "$tmp/squashfs-root" "$OPT"

echo "==> writing wrapper $WRAP"
mkdir -p "${HOME}/.local/bin"
cat > "$WRAP" <<EOF
#!/bin/sh
# Shadows /usr/bin/sioyek (AUR build) with the official prebuilt binary, which does
# not hard-abort on search (upstream bug ahrm/sioyek#1401 + Arch _GLIBCXX_ASSERTIONS).
# Regenerate with ~/.local/bin/sioyek-official-update.
exec "$OPT/usr/bin/sioyek" "\$@"
EOF
chmod +x "$WRAP"

# Desktop integration. The AUR package used to own sioyek.desktop + the icon; with
# the manual install we provide our own so PDFs open and sioyek shows in launchers.
echo "==> installing .desktop + icon and setting the PDF default"
ICON_SRC="$OPT/sioyek-icon-linux.png"
ICON_DST="${HOME}/.local/share/icons/sioyek.png"
DESKTOP="${HOME}/.local/share/applications/sioyek.desktop"
mkdir -p "${HOME}/.local/share/icons" "${HOME}/.local/share/applications"
[ -f "$ICON_SRC" ] && install -Dm644 "$ICON_SRC" "$ICON_DST"
cat > "$DESKTOP" <<EOF
[Desktop Entry]
Name=Sioyek
Comment=PDF viewer for reading research papers and technical books
Keywords=pdf;viewer;reader;research;
TryExec=$WRAP
Exec=$WRAP %f
StartupNotify=true
Terminal=false
Type=Application
Icon=$ICON_DST
Categories=Office;Viewer;
MimeType=application/pdf;
EOF
command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "${HOME}/.local/share/applications" >/dev/null 2>&1 || true
command -v xdg-mime >/dev/null 2>&1 && xdg-mime default sioyek.desktop application/pdf || true

hash -r 2>/dev/null || true
echo "==> done: $(command -v sioyek) -> $("$WRAP" --version 2>&1 | head -1)"
